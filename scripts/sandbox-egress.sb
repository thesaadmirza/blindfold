(version 1)
(allow default)
(deny mach-lookup (global-name "com.apple.SecurityServer"))
; Blindfold's config and its own scripts stay read-only, so a command can't
; widen where secrets may go or change what the hooks do. This lives here and
; not in sandbox.sb because macOS won't apply a profile with file rules inside
; another sandbox, and the base profile has to keep working inside one.
(deny file-write* (subpath (param "CONFIG_DIR")) (subpath (param "INSTALL_DIR")))
; Project tokens live here. A command that could read them could pass for
; another project and use that project's secrets.
(deny file-read* (subpath (param "PRIVATE_DIR")))
; The project's own policy only changes by the user's hand. An edit would just
; need approving again, but this keeps the agent from asking for it.
(deny file-write* (literal (param "PROJECT_POLICY")))
; Claude Code's settings, its plugins folder and the shell profiles it starts
; from can turn the hooks or lockdown off, so commands can't change those
; either. Any project's settings count, wherever the project is.
(deny file-write* (regex (param "CLAUDE_SETTINGS")) (regex #"/\.claude/settings(\.local)?\.json$"))
; Nor rename or remove a folder above anything protected here, which would
; take it away along with the folder
(deny file-write* (regex (param "PARENT_DIRS")))
; Outbound traffic may only reach loopback, where the Blindfold proxy and any
; local dev servers listen. Everything else has to go through the proxy.
(deny network-outbound)
(allow network-outbound (remote ip "localhost:*"))
